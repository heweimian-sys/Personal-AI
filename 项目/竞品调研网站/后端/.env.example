# ============================================
# 知行·认知加速器 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# 应用配置
APP_NAME=知行
DEBUG=true

# 数据库（SQLite，无需额外服务）
DATABASE_URL=sqlite+aiosqlite:///./data/zhixin.db

# Firecrawl 搜索服务（自部署，二选一）
# 参考：https://github.com/firecrawl/firecrawl
# 自部署后填入你的 Firecrawl 服务地址和 API Key
FIRECRAWL_API_URL=http://localhost:3002/v1
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Tavily 搜索服务（免费推荐，二选一）
# 注册：https://tavily.com → 免费 1000 次/月
# 配置后自动优先使用，无需自部署
TAVILY_API_KEY=tvly-your-key

# DeepSeek AI 服务
# 注册地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容模型服务（配置后优先于 DeepSeek）
MODEL_API_KEY=sk-your-openai-compatible-key
MODEL_BASE_URL=https://your-openai-compatible-endpoint
MODEL_NAME=gpt-5.5
OPENAI_API_KEY=sk-your-openai-compatible-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint
OPENAI_MODEL=gpt-5.5
MODEL_WIRE_API=responses
MODEL_REASONING_EFFORT=xhigh
DISABLE_RESPONSE_STORAGE=true

# CORS（前端地址）
CORS_ORIGINS=http://localhost:3000
